# ARK Server Commander 环境配置示例
# 复制此文件为 .env 并填入实际值

# JWT密钥（可选）
# 不设置时，后端首次启动会自动生成强随机密钥并保存到数据库目录下的 jwt_secret 文件（镜像内为 /data/jwt_secret）
# 只有需要自己管理密钥时才设置，要求至少32字符，生成方法: openssl rand -base64 48
# JWT_SECRET=

# 数据库路径
DB_PATH=/data/ark_server.db

# 本地直接运行后端时使用的端口
# Docker 镜像内由 docker-entrypoint.sh 固定（对外 8080，后端内部 8081），此项在容器内会被忽略
SERVER_PORT=8080

# Gin运行模式 (debug/release)
GIN_MODE=release

# 日志级别 (debug/info/warn/error/fatal)
LOG_LEVEL=info

# 日志格式 (json/console)
# json - 生产环境推荐，便于日志收集系统解析
# console - 开发环境推荐，彩色输出，人类可读
LOG_FORMAT=console

# 允许跨域的来源白名单，逗号分隔（如 http://localhost:3000）
# 前端通过 Next 代理访问后端，通常无需配置；留空表示仅同源
CORS_ALLOWED_ORIGINS=

# 登录 cookie 是否带 Secure 标记；通过 HTTPS 访问时设为 true，纯 HTTP 访问时保持 false，否则无法登录
COOKIE_SECURE=false

# ARK 服务器容器的时区，仅对新建或重建的容器生效，默认 Asia/Shanghai
# CONTAINER_TZ=Asia/Shanghai

# 玩家连接用的公网地址（IP 或域名），显示在服务器卡片和详情页上
# 留空时后端自动探测公网 IP（访问 api.ipify.org，缓存 1 小时）；有域名或探测结果不对时手动设置
# PUBLIC_HOST=

# 存档备份目录，默认为数据库所在目录下的 backups（镜像内为 /data/backups，随 ./data 一起持久化）
# BACKUP_DIR=/data/backups

# 数据目录在宿主机上的绝对路径（可选）
# ARK 服务器的服务端文件、存档、插件和集群数据放在数据目录下的 servers/<id>/ 和 clusters/<cluster_id>/，宿主机上可以直接管理
# 后端运行在容器里时会检查自身的挂载自动探测；探测失败（报错提示设置 HOST_DATA_DIR）时手动指定，如 /opt/ark/data
# HOST_DATA_DIR=
